generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         String    @default("admin") // admin | staff
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// Lead vindo do bot / site / manual
model Lead {
  id              String     @id @default(cuid())
  name            String
  company         String?
  email           String?
  phone           String?
  whatsappId      String?
  address         String?
  projectType     String?
  deadline        String?
  briefing        String?
  answers         Json?
  totalInvestment Float      @default(0)
  entryPayment    Float      @default(0)
  status          String     @default("novo") // novo | discovery | proposta_enviada | aceita | perdida | recrutador
  source          String     @default("whatsapp") // whatsapp | site | manual | recruiter
  intent          String?    // proposta | recrutador | produto_teron | cliente
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  proposals       Proposal[]
  projects        Project[]
}

/// Proposta comercial enviada ao cliente
model Proposal {
  id          String    @id @default(cuid())
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id])
  title       String
  content     String?
  amount      Float     @default(0)
  entryAmount Float     @default(0)
  status      String    @default("rascunho") // rascunho | enviada | visualizada | aceita | recusada | expirada
  validUntil  DateTime?
  version     Int       @default(1)
  publicToken String    @unique @default(cuid())
  viewedAt    DateTime?
  acceptedAt  DateTime?

  /// Trilha de auditoria da assinatura eletronica
  signerName      String?
  signerEmail     String?
  signerIp        String?
  signerUserAgent String?
  signedAt        DateTime?
  /// SHA-256 do conteudo exato do contrato no momento da assinatura
  contractHash    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  project     Project?
  payments    Payment[]
  otps        SignatureOtp[]
}

/// Projeto ativo (após proposta aceita / pago)
model Project {
  id              String   @id @default(cuid())
  title           String
  clientName      String
  clientEmail     String?
  clientCompany   String?
  status          String   @default("em_andamento") // onboarding | em_andamento | pausado | concluido | cancelado
  deadline        String?
  budget          Float    @default(0)
  description     String?
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  proposalId      String?  @unique
  proposal        Proposal? @relation(fields: [proposalId], references: [id])
  /// Token de acesso do cliente à workstation (sem login complexo no início)
  clientAccessToken String? @unique @default(cuid())
  /// Dados visíveis no painel do cliente (checklist, links, notas)
  clientPortal    Json?
  /// Expiracao do acesso do cliente por token (renovavel)
  clientTokenExpiresAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        Payment[]
}

/// Cobranca / recebimento vinculado a uma proposta ou projeto.
/// Fonte unica de verdade financeira: so o webhook assinado marca "pago".
model Payment {
  id          String    @id @default(cuid())
  proposalId  String?
  proposal    Proposal? @relation(fields: [proposalId], references: [id])
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id])

  provider    String // stripe | mercadopago | manual
  /// ID no provedor (checkout session, payment id). Unico p/ idempotencia.
  providerRef String?   @unique
  kind        String    @default("entrada") // entrada | parcela | final
  amount      Float
  currency    String    @default("BRL")
  status      String    @default("pendente") // pendente | pago | falhou | reembolsado | expirado
  method      String? // pix | card | boleto
  description String?
  paidAt      DateTime?
  /// Payload bruto do provedor, para auditoria/disputa
  rawEvent    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([proposalId])
  @@index([projectId])
  @@index([status])
}

/// Codigo de uso unico enviado por e-mail para assinar a proposta.
/// Guardamos apenas o hash do codigo.
model SignatureOtp {
  id         String    @id @default(cuid())
  proposalId String
  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([proposalId])
}

model Tenant {
  id             String           @id @default(cuid())
  name           String
  slug           String           @unique
  nicheId        String           @default("generic")
  plan           String           @default("starter") // starter | pro | business
  status         String           @default("provisioning") // provisioning | qr_pending | live | suspended
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  ownerName      String?
  ownerEmail     String?
  ownerPassword  String?
  ownerToken     String?
  whatsappPhone  String?
  appointments   BotAppointment[]
  services       BotService[]
  barbers        Barber[]
  messages       BotMessage[]
  config         BotConfig?
}

model BotConfig {
  id                String   @id @default(cuid())
  tenantId          String   @unique
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  aiPrompt          String?
  noShowGraceMin    Int      @default(25)
  unpaidRemindHours Int      @default(12)
  maxTenants        Int      @default(50)
  panelUrl          String   @default("http://localhost:8788")
  adminUrl          String   @default("http://localhost:8787/admin")
  updatedAt         DateTime @updatedAt
}

model BotService {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  price       Float    @default(0)
  durationMin Int      @default(30)
  category    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Barber {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  nickname   String
  specialty  String
  schedule   Json     // stores working hours schedule Record<string, [string, string]>
  onDuty     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BotAppointment {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatId      String
  clientName  String
  serviceId   String
  serviceName String
  barberId    String
  barberName  String
  date        String
  time        String
  price       Float
  status      String   // booked | awaiting_payment | paid | checked_in | waiting | in_service | done | rated | cancelled | no_show
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BotMessage {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chatId    String
  sender    String   // client | bot | owner
  text      String
  timestamp DateTime @default(now())
}

# Preferência: npm run config

# Motor: script | hybrid | ai
ENGINE_MODE=hybrid
AI_SELECTED=GEMINI
ACTIVE_CONNECTION_ID=gemini-free

# Nicho TERON OS (comercial B2B)
NICHE_ID=teron
ASSISTANT_NAME=Teron
COMPANY_NAME=TERON OS
COMPANY_DESCRIPTION=Sistema operacional para studios de software.
SESSION_NAME=teron
DEVICE_NAME=Teron Bot
LEAD_CAPTURE=true
FALLBACK_MESSAGE=Recebi sua mensagem! Em que posso ajudar?

# URL da OS (obrigatório para criar propostas reais)
TERON_OS_URL=http://localhost:3005
# Produção:
# TERON_OS_URL=https://os.thomaseduardo.com.br

# Gemini
GEMINI_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (opcional)
OPENAI_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama (opcional)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Mercado Pago (opcional no bot)
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_PUBLIC_KEY=

CHROME_PATH=/usr/bin/google-chrome
